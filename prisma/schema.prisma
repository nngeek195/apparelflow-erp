datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  CUTTING_IN_PROGRESS
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum ItemStatus {
  GREEN
  YELLOW
  RED
}

model Recipe {
  id               String            @id @default(uuid())
  recipeCode       String            @unique
  name             String
  category         String
  stdFabricYards   Float
  wastageCap       Float
  components       RecipeComponent[]
  orders           CuttingOrder[]
  createdAt        DateTime          @default(now())
}

model RecipeComponent {
  id               String             @id @default(uuid())
  recipeId         String
  componentName    String
  piecesPerGarment Int
  imageUrl         String?
  recipe           Recipe             @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  verificationItems VerificationItem[]
}

model CuttingOrder {
  id                String             @id @default(uuid())
  orderNo           String             @unique
  recipeId          String
  targetQty         Int
  fabricRollId      String
  actualFabricYds   Float
  status            OrderStatus        @default(CUTTING_IN_PROGRESS)
  
  creatorId         String
  creatorEmail      String?
  creatorName       String?
  
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  recipe            Recipe             @relation(fields: [recipeId], references: [id])
  items             VerificationItem[]
  verificationLog   VerificationLog?
}

model VerificationItem {
  id             String          @id @default(uuid())
  orderId        String
  componentId    String
  expectedQty    Int
  actualQty      Int
  status         ItemStatus
  
  order          CuttingOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  component      RecipeComponent @relation(fields: [componentId], references: [id])
}

model VerificationLog {
  id             String       @id @default(uuid())
  orderId        String       @unique
  verifierId     String
  verifierName   String?
  decision       String       
  rejectionNote  String?
  wastagePct     Float
  timestamp      DateTime     @default(now())
  
  order          CuttingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}